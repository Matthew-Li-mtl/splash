# Copy to .env (which is gitignored) and fill in. On Render, set these in the dashboard instead.
PORT=4000
# Atlas → Database → Connect → Drivers. Leave the db name out; MONGO_DB picks it.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB=splash
# Any long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me
# Optional: extra web origins allowed to call the API, comma-separated (only needed if the
# client is hosted somewhere other than this server).
CLIENT_ORIGINS=
# Optional: per-user photo storage cap in MB (default 15).
ASSET_QUOTA_MB=15
